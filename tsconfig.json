{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./packages/studio/src/*"]
    },
    "types": ["node", "react", "react-dom"]
  },
  "references": [
    { "path": "./packages/domain-model/tsconfig.json" },
    { "path": "./packages/codegen/tsconfig.json" },
    { "path": "./packages/activities/tsconfig.json" },
    { "path": "./packages/diagram-core/tsconfig.json" },
    { "path": "./packages/validation/tsconfig.json" }
  ]
}

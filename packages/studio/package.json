{
  "name": "rpaforge-studio",
  "version": "0.4.0",
  "description": "RPAForge Studio - Visual RPA IDE built on Electron and React",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:dist": "node scripts/build-bridge.mjs && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "i18n:extract": "i18next-scanner --config i18next-scanner.config.cjs"
  },
  "keywords": [
    "rpa",
    "automation",
    "visual-designer",
    "electron",
    "react"
  ],
  "author": "RPAForge Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@rpaforge/activities": "workspace:^",
    "@rpaforge/codegen": "workspace:^",
    "@rpaforge/diagram-core": "workspace:^",
    "@rpaforge/domain-model": "workspace:^",
    "@rpaforge/validation": "workspace:^",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.11.1",
    "chokidar": "^5.0.0",
    "elkjs": "^0.11.1",
    "i18next": "^26.3.3",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^4.0.0",
    "immer": "^11.1.8",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.6.0",
    "react-joyride": "^3.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.9",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/validator": "^13.12.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.9",
    "ajv": "^8.18.0",
    "conventional-changelog-cli": "^5.0.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "rollup": "^4.62.2",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tar": ">=7.5.15",
    "dompurify": ">=3.4.11",
    "@tootallnate/once": ">=3.0.1"
  },
  "build": {
    "appId": "com.rpaforge.studio",
    "productName": "RPAForge Studio",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "resources/bridge",
        "to": "bridge"
      },
      {
        "from": "resources/pw-browsers",
        "to": "pw-browsers"
      },
      {
        "from": "resources/tesseract",
        "to": "tesseract"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage"
    }
  }
}

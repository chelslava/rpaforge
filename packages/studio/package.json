{
  "name": "rpaforge-studio",
  "version": "0.5.0",
  "description": "RPAForge Studio - Visual RPA IDE built on Electron and React",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:renderer && electron-builder",
    "build:renderer": "vite build && pnpm check:bundle",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:dist": "node scripts/build-bridge.mjs && pnpm build:renderer && electron-builder",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "electron:dev": "vite",
    "electron:build": "pnpm build:renderer && electron-builder",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "i18n:extract": "i18next-scanner --config i18next-scanner.config.cjs"
  },
  "keywords": [
    "rpa",
    "automation",
    "visual-designer",
    "electron",
    "react"
  ],
  "author": "RPAForge Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@rpaforge/activities": "workspace:^",
    "@rpaforge/codegen": "workspace:^",
    "@rpaforge/diagram-core": "workspace:^",
    "@rpaforge/domain-model": "workspace:^",
    "@rpaforge/validation": "workspace:^",
    "@types/dompurify": "^3.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.11.5",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.14",
    "elkjs": "^0.12.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^4.0.1",
    "immer": "^11.1.17",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-i18next": "^17.0.12",
    "react-icons": "^5.7.0",
    "react-joyride": "^3.2.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.12",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/validator": "^13.12.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "ajv": "^8.18.0",
    "conventional-changelog-cli": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.6",
    "lint-staged": "^17.3.0",
    "rollup": "^4.63.0",
    "sass": "^1.103.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tar": ">=7.5.21",
    "dompurify": ">=3.4.13",
    "@tootallnate/once": ">=3.0.1"
  },
  "build": {
    "appId": "com.rpaforge.studio",
    "productName": "RPAForge Studio",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "resources/bridge",
        "to": "bridge"
      },
      {
        "from": "resources/pw-browsers",
        "to": "pw-browsers"
      },
      {
        "from": "resources/tesseract",
        "to": "tesseract"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage"
    }
  }
}

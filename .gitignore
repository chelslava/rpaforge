# Build outputs
*.js.map
*.d.ts
dist-electron/
dist/
release/
out/

# PyInstaller engine bundle (built by `pnpm build:bridge`)
.pyinstaller-build/
packages/studio/resources/bridge/*
!packages/studio/resources/bridge/.gitkeep

# Bundled optional tooling (populated in CI, shipped via extraResources)
packages/studio/resources/pw-browsers/*
!packages/studio/resources/pw-browsers/.gitkeep
packages/studio/resources/tesseract/*
!packages/studio/resources/tesseract/.gitkeep

# Electron
*.asar

# Compiled Electron main-process sources must never be committed: vite resolves
# `import './python-bridge'` to a `.js` before the `.ts`, so a stale committed
# electron/*.js silently shadows the real source and ships old code in the build.
packages/studio/electron/*.js


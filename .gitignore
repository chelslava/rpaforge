# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
# ...except the Studio packaging assets (app icons). These are committed
# source, not build output; the broad `build/` rule above would otherwise drop
# them and break the electron-builder installer step.
!packages/studio/build/
!packages/studio/build/icon.ico
!packages/studio/build/icon.png
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec
# ...except the committed engine build spec, which CI depends on.
!packages/core/rpaforge-bridge.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt


{
  "name": "rpaforge",
  "version": "0.4.1",
  "description": "RPAForge - Visual RPA IDE",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/domain-model",
    "packages/codegen",
    "packages/activities",
    "packages/diagram-core",
    "packages/validation",
    "packages/studio"
  ],
  "scripts": {
    "dev": "npm -w packages/studio run dev",
    "build": "npm run build -ws",
    "test": "npm test -ws",
    "lint": "npm -w packages/studio run lint",
    "lint:fix": "npm -w packages/studio run lint:fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "vite": "8.0.16"
  },
  "overrides": {
    "browserslist": ">=4.28.7",
    "tar": ">=7.5.21",
    "dompurify": ">=3.4.13",
    "@tootallnate/once": ">=3.0.1"
  }
}
